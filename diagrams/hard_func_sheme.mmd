config:
  layout: elk
  flowchart:
    wrappingWidth: 400
---
flowchart TB
classDef pc fill:#eaf2fb,stroke:#2874a6,color:#000
classDef mcu fill:#fef5e7,stroke:#b9770e,color:#000
classDef prot fill:#fdedec,stroke:#c0392b,stroke-width:2px,color:#000
classDef io fill:#e9f7ef,stroke:#1e8449,color:#000

subgraph PC["КОМПЬЮТЕР · панель оператора (локальная сеть)"]
H1["Задание:<br/>ID, линия, доза"]:::pc
H4["Кнопка СТОП"]:::pc
H2["Отображение: линия, задано/измерено,<br/>состояние, причина;<br/>нет ответа > T → «ДАННЫЕ УСТАРЕЛИ»"]:::pc
H3["Журнал, экспорт"]:::pc
end

subgraph MCU["КОНТРОЛЛЕР ESP32 · работает автономно, без панели"]
C1["Приём задания: проверка ID, линии, дозы<br/>повтор ID → без новой порции · занят → отказ"]:::mcu
C2["Проверка перед пуском: вода, весы, тара"]:::mcu
C3["Выбор линии: открыть свой клапан,<br/>второй обесточен (NC)"]:::mcu
C4["Измеряемая подача: V = Δm / ρ<br/>стоп по m_стоп (с учётом «хвоста»)"]:::mcu
C5["ЗАЩИТЫ — всё время подачи:<br/>нет подачи ≤ 10 с · нет воды<br/>отказ весов · t_max · СТОП"]:::prot
C7["Остановка: насос выкл → пауза → клапан закрыть<br/>→ дождаться стабилизации весов"]:::mcu
C6["Результат по измерению: ЗАВЕРШЕНО / НЕТ ПОДАЧИ /<br/>НЕТ ВОДЫ / ОТКАЗ ИЗМЕРЕНИЯ / ПРЕРВАНО<br/>→ запись в журнал"]:::mcu
C1 --> C2 --> C3 --> C4
C4 -->|"m_стоп достигнута"| C7
C5 -->|"срабатывание"| C7
C7 --> C6
end

subgraph SENS["ДАТЧИКИ"]
S1["Весы HX711"]:::io
S2["Поплавок"]:::io
end

subgraph ACT["ИСПОЛНИТЕЛЬНЫЕ УСТРОЙСТВА"]
A1["Реле насоса"]:::io
A2["Клапан A"]:::io
A3["Клапан B"]:::io
end

H1 -->|"POST /api/start"| C1
C1 -.->|"подтверждение ПРИЁМА:<br/>ID принят / отклонён"| H2
H4 -->|"POST /api/stop"| C5
C6 -->|"подтверждение ВЫПОЛНЕНИЯ:<br/>GET /api/state, /api/log"| H2
C6 --> H3

S1 --> C4
S1 -.-> C5
S2 --> C2
S2 -.-> C5
C3 --> A1 & A2 & A3
