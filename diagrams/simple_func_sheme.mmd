flowchart TB
    subgraph SENS["ДАТЧИКИ"]
        FL["Поплавок<br/>есть ли вода в баке"]
        SC["Весы под баком<br/>сколько воды ушло<br/>V = Δm / ρ(T)"]
    end

    subgraph DEV["УПРАВЛЯЮЩЕЕ УСТРОЙСТВО · работает само, даже без компьютера"]
        BOOT["Включение питания:<br/>насос и клапаны ВЫКЛЮЧЕНЫ, самозапуска нет.<br/>Был прерванный цикл → записать ПРЕРВАНО,<br/>ждать решения оператора"]
        CHK["Получить задание и проверить:<br/>ID, линия, доза.<br/>Тот же ID повторно — не наливать второй раз.<br/>Занято, линия или доза вне диапазона — отказать"]
        PRE["Перед пуском проверить:<br/>есть ли вода, работают ли весы, снята ли тара"]
        SEL["Выбрать линию:<br/>открыть её клапан,<br/>второй закрыт и обесточен"]
        PRM["Первое заполнение трубок —<br/>учитывается ОТДЕЛЬНО, в дозу не входит"]
        DOSE["Подавать воду и считать по весам.<br/>Остановить чуть раньше нормы —<br/>с учётом того, что дотечёт после выключения"]
        GUARD["ЗАЩИТА · следит всё время полива:<br/>нет прироста массы за 3 с → стоп<br/>(полная реакция не позже 10 с по ТЗ)<br/>вода кончилась · весы отказали<br/>полив дольше предельного времени<br/>нажата кнопка СТОП на корпусе"]
        STOP["Остановить:<br/>насос ВЫКЛ → СРАЗУ закрыть клапан →<br/>дождаться, пока весы успокоятся"]
        RES["Итог — только по весам:<br/>ВЫПОЛНЕНО (отклонение не больше 10 %<br/>и весы были исправны весь цикл)<br/>ВОДА НЕ ПОШЛА · НЕТ ВОДЫ · ВЕСЫ НЕИСПРАВНЫ<br/>ПРЕРВАНО · АВАРИЯ (таймаут)<br/>Записать в журнал"]
    end

    subgraph ACT["ИСПОЛНИТЕЛЬНЫЕ УСТРОЙСТВА"]
        P["Насос"]
        VA["Клапан линии 1<br/>нормально закрытый"]
        VB["Клапан линии 2<br/>нормально закрытый"]
    end

    BTN["Кнопка СТОП на корпусе"]

    subgraph PC["КОМПЬЮТЕР ОПЕРАТОРА"]
        OP["Оператор задаёт:<br/>ID, линию и сколько налить"]
        STP["Кнопка СТОП"]
        SCR["Экран: линия, задано и налито,<br/>что происходит, почему остановились.<br/>Нет связи → ДАННЫЕ УСТАРЕЛИ,<br/>новые задания недоступны"]
        LOG["Журнал: время, ID, линия,<br/>задано и налито, состояние, команда,<br/>итог, причина, калибровка, единицы"]
    end

    NOTE["Граница метода: измеряем убыль из бака,<br/>поэтому НЕ утверждаем,<br/>что каждая капельница исправна"]
    NOTE2["Весы: трубки и провода не тянут платформу<br/>(свободная петля), насос не на весах,<br/>электроника размещена отдельно от воды"]

    FL --> PRE
    FL --> GUARD
    SC --> DOSE
    SC --> GUARD
    SC --> RES
    SC -.-> NOTE
    SC -.-> NOTE2

    OP -->|"задание"| CHK
    CHK -->|"ответ сразу: принято или отклонено"| SCR
    BOOT --> CHK
    CHK --> PRE --> SEL --> PRM --> DOSE
    DOSE -->|"норма налита"| STOP
    GUARD -->|"сработала"| STOP
    BTN --> GUARD
    STP -->|"команда стоп"| GUARD

    SEL --> VA
    SEL --> VB
    DOSE --> P
    STOP --> P
    STOP --> VA
    STOP --> VB
    STOP --> RES
    RES -->|"ответ в конце: налито столько-то, итог такой-то"| SCR
    RES --> LOG
    LOG -->|"после восстановления связи — итог,<br/>пропуски не заполняются выдуманными числами"| SCR
